{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "backend": "node --env-file-if-exists=.env backend/migrate.mjs && node --env-file-if-exists=.env backend/server.mjs",
    "db:migrate": "node --env-file-if-exists=.env backend/migrate.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test --test-concurrency=1 tests/rendered-html.test.mjs tests/backend-contract.test.mjs tests/backend-contract-extended.test.mjs tests/guest-order-realdb.test.mjs tests/guest-merge-contract.test.mjs tests/price-snapshot-contract.test.mjs tests/order-price-audit-contract.test.mjs tests/order-integrity-contract.test.mjs",
    "test:reports-realdb": "node --test tests/reports-realdb.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

